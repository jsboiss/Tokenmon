<Window x:Class="Tokenmon.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Tokenmon" Height="760" Width="430"
        ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True">
    <Border Margin="14" CornerRadius="22" Background="{StaticResource PanelBrush}"
            BorderBrush="#FF343A50" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.45" Color="#FF000000" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="HeaderMouseDown">
                <StackPanel>
                    <TextBlock Text="TOKENMON" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Your coding companion" FontSize="19" FontWeight="SemiBold" Margin="0,2,0,0" />
                </StackPanel>
                <Button Content="×" HorizontalAlignment="Right" VerticalAlignment="Top"
                        FontSize="18" Width="34" Height="34" Padding="0" Click="CloseClick" />
            </Grid>

            <Border Grid.Row="1" Margin="0,18,0,14" Padding="18" CornerRadius="18" Background="{StaticResource CardBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="104" Height="104">
                        <Ellipse Fill="#FF151824" />
                        <Grid Width="64" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEgg}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Ellipse Stroke="#FFE2A93B" StrokeThickness="3">
                                <Ellipse.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFFFF3BE" />
                                        <GradientStop Color="#FFFFD96A" Offset="1" />
                                    </LinearGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="14" Height="18" Fill="#FFECA94B" Margin="11,13,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Ellipse Width="11" Height="14" Fill="#FFFFE99A" Margin="0,0,10,15" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            <Ellipse Width="8" Height="11" Fill="#FFF1B54B" Margin="0,25,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>
                        <Image Source="{Binding SpritePath}" Width="96" Height="96" RenderOptions.BitmapScalingMode="NearestNeighbor">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEgg}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="{Binding CompanionName}" FontSize="23" FontWeight="Bold" />
                        <TextBlock Text="{Binding CompanionCaption}" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,12" />
                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="{StaticResource AccentBrush}" Background="#FF10121A" />
                        <TextBlock Text="{Binding ProgressLabel}" FontSize="11" Foreground="{StaticResource MutedInkBrush}" Margin="0,5,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Padding="18,15" CornerRadius="16" Background="#FF1D2130">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="TODAY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" />
                        <TextBlock Text="{Binding TodayTokens}" FontSize="31" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding InputTokens, StringFormat=Input  {0}}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding OutputTokens, StringFormat=Output  {0}}" FontSize="12" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding CacheTokens, StringFormat=Cache  {0}}" FontSize="12" HorizontalAlignment="Right" Foreground="{StaticResource MutedInkBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="3" Margin="0,14,0,0" Background="Transparent" BorderThickness="0">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="9,7" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TabItem">
                                    <Border x:Name="TabBorder" Background="Transparent" CornerRadius="6" Margin="0,0,3,0">
                                        <ContentPresenter ContentSource="Header" Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource CardBrush}" /></Trigger>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#FF292E40" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </TabControl.Resources>

                <TabItem Header="Home">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="SOURCES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" Margin="2,0,0,7" />
                        <ItemsControl ItemsSource="{Binding VisibleProviders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="12,9" Margin="0,0,0,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="7" Height="7" Fill="#FF63D99B" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Provider}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Sessions, StringFormat=  · {0} sessions}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Today.Total, StringFormat={}{0:N0}}" FontWeight="SemiBold" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#FF1D2130" CornerRadius="12" Padding="14" Margin="0,5,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="TOKEN WALLET" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" />
                                    <TextBlock Text="{Binding WalletTokens}" FontSize="24" FontWeight="Bold" />
                                    <TextBlock Text="{Binding HistoricalWalletLabel}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CollectionCount, StringFormat=Collection  {0}}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{Binding GraduationCount, StringFormat=Graduated  {0}}" Foreground="{StaticResource MutedInkBrush}" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,8,0,0"
                                Visibility="{Binding HasCodexLimits, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding FiveHourPercent, StringFormat=5-hour  {0}%}" FontSize="11" FontWeight="SemiBold" />
                                    <ProgressBar Value="{Binding FiveHourPercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="{StaticResource AccentBrush}" Background="#FF10121A" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding FiveHourReset}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding WeeklyPercent, StringFormat=Weekly  {0}%}" FontSize="11" FontWeight="SemiBold" />
                                    <ProgressBar Value="{Binding WeeklyPercent, Mode=OneWay}" Maximum="100" Height="6" Foreground="#FF63D99B" Background="#FF10121A" Margin="0,5,0,0" />
                                    <TextBlock Text="{Binding WeeklyReset}" FontSize="9" Foreground="{StaticResource MutedInkBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Pokédex">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="CATCH LOG" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" Margin="2,0,0,7" />
                            <TextBlock Text="Every companion you have raised, newest first." Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="2,0,0,10" />
                            <ItemsControl ItemsSource="{Binding CatchLog}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Image Source="{Binding SpriteUrl}" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding Nature, StringFormat={}{0} nature}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Bag">
                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="ITEMS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedInkBrush}" Margin="2,0,0,8" />
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                            <Grid>
                                <StackPanel><TextBlock Text="🍬  Rare Candy" FontWeight="Bold" FontFamily="Segoe UI Emoji" /><TextBlock Text="Adds 100M growth" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /><TextBlock Text="{Binding RareCandyCount, StringFormat=Owned: {0}}" /></StackPanel>
                                <Button Content="Use" HorizontalAlignment="Right" VerticalAlignment="Center" Click="UseCandyClick" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14" Margin="0,0,0,9">
                            <Grid>
                                <StackPanel><TextBlock Text="🌿  Mint" FontWeight="Bold" FontFamily="Segoe UI Emoji" /><TextBlock Text="Rerolls your companion's nature" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /><TextBlock Text="{Binding MintCount, StringFormat=Owned: {0}}" /></StackPanel>
                                <Button Content="Use" HorizontalAlignment="Right" VerticalAlignment="Center" Click="UseMintClick" />
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="14">
                            <StackPanel><TextBlock Text="✨  Shiny Charm" FontWeight="Bold" FontFamily="Segoe UI Emoji" /><TextBlock Text="{Binding ShinyCharmStatus}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Shop">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding WalletTokens, StringFormat=AVAILABLE  {0} TOKENS}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="2,0,0,8" />
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,7"><Grid><StackPanel><TextBlock Text="🌿 Mint" FontFamily="Segoe UI Emoji" FontWeight="Bold" /><TextBlock Text="100M · nature reroll" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel><Button Tag="Mint" Content="Buy" IsEnabled="{Binding CanBuyMint}" HorizontalAlignment="Right" Click="BuyClick" /></Grid></Border>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,7"><Grid><StackPanel><TextBlock Text="🍬 Rare Candy" FontFamily="Segoe UI Emoji" FontWeight="Bold" /><TextBlock Text="500M · adds 100M growth" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel><Button Tag="RareCandy" Content="Buy" IsEnabled="{Binding CanBuyCandy}" HorizontalAlignment="Right" Click="BuyClick" /></Grid></Border>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,7"><Grid><StackPanel><TextBlock Text="🥚 Pokémon Egg" FontFamily="Segoe UI Emoji" FontWeight="Bold" /><TextBlock Text="1B · starts over with a fresh egg" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel><Button Tag="PokemonEgg" Content="Buy" IsEnabled="{Binding CanBuyPokemonEgg}" HorizontalAlignment="Right" Click="BuyClick" /></Grid></Border>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,7"><Grid><StackPanel><TextBlock Text="🥚 Uncommon Egg" FontFamily="Segoe UI Emoji" FontWeight="Bold" /><TextBlock Text="2.5B · Uncommon or better" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel><Button Tag="UncommonEgg" Content="Buy" IsEnabled="{Binding CanBuyUncommonEgg}" HorizontalAlignment="Right" Click="BuyClick" /></Grid></Border>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,7"><Grid><StackPanel><TextBlock Text="✨ Shiny Charm" FontFamily="Segoe UI Emoji" FontWeight="Bold" /><TextBlock Text="3B · permanent 1/48 shiny odds" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel><Button Tag="ShinyCharm" Content="Buy" IsEnabled="{Binding CanBuyCharm}" HorizontalAlignment="Right" Click="BuyClick" /></Grid></Border>
                            <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12"><Grid><StackPanel><TextBlock Text="🥚 Rare Egg" FontFamily="Segoe UI Emoji" FontWeight="Bold" /><TextBlock Text="4B · Rare or better" Foreground="{StaticResource MutedInkBrush}" FontSize="11" /></StackPanel><Button Tag="RareEgg" Content="Buy" IsEnabled="{Binding CanBuyRareEgg}" HorizontalAlignment="Right" Click="BuyClick" /></Grid></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Settings">
                    <StackPanel Margin="3,15,0,0">
                        <CheckBox Content="Show floating companion" IsChecked="{Binding Settings.ShowFloatingPet}" Foreground="{StaticResource InkBrush}" Click="SettingChanged" />
                        <CheckBox Content="Start Tokenmon with Windows" IsChecked="{Binding Settings.StartWithWindows}" Foreground="{StaticResource InkBrush}" Margin="0,12,0,0" Click="SettingChanged" />
                        <TextBlock Text="Pet size" Margin="0,18,0,6" />
                        <Slider Value="{Binding Settings.PetSize}" Minimum="64" Maximum="192" Width="210" HorizontalAlignment="Left" IsSnapToTickEnabled="True" TickFrequency="8" ValueChanged="PetSizeChanged" />
                        <TextBlock Text="Progress and catches are saved locally under %LOCALAPPDATA%\Tokenmon." TextWrapping="Wrap" Foreground="{StaticResource MutedInkBrush}" FontSize="11" Margin="0,22,0,0" />
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="4" Margin="0,12,0,0">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedInkBrush}" FontSize="11" VerticalAlignment="Center" />
                <Button Content="Refresh" HorizontalAlignment="Right" Click="RefreshClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
